# No API keys are required for grocery scanning.
#
# Barcode product details are read from Open Food Facts.
# Puregold and SM prices are saved locally on the device after you enter them.

# Optional: enables the Ask AI button for meal ideas from scanned groceries.
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_MODEL=gemini-2.0-flash

# Optional: enables shared Puregold/SM price memory through Firebase Firestore.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
